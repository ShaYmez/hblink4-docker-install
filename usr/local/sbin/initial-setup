if [ -f /usr/local/lib/hblink4/common.sh ]; then
	. /usr/local/lib/hblink4/common.sh
else
	_ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
	. "${_ROOT}/lib/common.sh"
fi

export TERM="${TERM:-xterm}"

read_choice() {
	local prompt="${1:-  Select: }"
	printf "%s" "$prompt"
	if ! IFS= read -r MENU_CHOICE; then
		MENU_CHOICE=""
		return 1
	fi
}

while : ; do
	clear
	print_banner
	print_status_box
	print_menu_box "Initial Setup" \
		"1|Re-Install" \
		"2|Bash shell (type exit to return)" \
		"3|Edit engine config.json" \
		"4|Edit dashboard config.json" \
		"5|Start HBlink4 stack" \
		"6|Stop HBlink4 stack" \
		"7|System apt update && upgrade" \
		"8|Finish setup & exit"
	read_choice || exit 0
	case "$MENU_CHOICE" in
		1)
			INSTALLER_PATH="$(installer_path)"
			if [ -f "${INSTALLER_PATH}/hblink4-docker-install.sh" ]; then
				sudo "${INSTALLER_PATH}/hblink4-docker-install.sh"
			else
				err "Installer not found at ${INSTALLER_PATH}"
				pause
			fi
			;;
		2) sudo /usr/bin/bash ;;
		3) sudo ${EDITOR:-nano} "${HBDIR}/config/config.json" ;;
		4) sudo ${EDITOR:-nano} "${HBDIR}/dashboard/config.json" ;;
		5) sudo /usr/local/sbin/hblink4-start all; pause ;;
		6) sudo /usr/local/sbin/hblink4-stop; pause ;;
		7) sudo apt-get update -y && sudo apt-get upgrade; pause ;;
		8)
			sudo /usr/local/sbin/hblink4-flush
			exit 0
			;;
		0|q|Q) exit 0 ;;
	esac
done
exit 0
