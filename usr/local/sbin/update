#!/bin/bash
# HBlink4 Docker control — update (git pull installer + HBlink4, rebuild)
# Version 1.0.0 (07092026)
#
#   Copyright (C) 2026 Shane Daley, M0VUB aka ShaYmez. <shane@freestar.network>
#
#   This program is free software; you can redistribute it and/or modify
#   it under the terms of the GNU General Public License as published by
#   the Free Software Foundation; either version 3 of the License, or
#   (at your option) any later version.

if [ -f /usr/local/lib/hblink4/common.sh ]; then
	. /usr/local/lib/hblink4/common.sh
else
	_ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
	if [ ! -f "${_ROOT}/lib/common.sh" ]; then
		_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
	fi
	. "${_ROOT}/lib/common.sh"
fi

require_root

INSTALLER_PATH="$(installer_path)"
SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
REPO_UPDATE="${INSTALLER_PATH}/usr/local/sbin/update"

if [ -f "$REPO_UPDATE" ]; then
	REPO_UPDATE_ABS="$(readlink -f "$REPO_UPDATE" 2>/dev/null || echo "$REPO_UPDATE")"
	if [ "$SELF" != "$REPO_UPDATE_ABS" ]; then
		echo "Re-running update from installer tree..."
		exec bash "$REPO_UPDATE_ABS" "$@"
	fi
fi

if [ -d "${INSTALLER_PATH}/.git" ]; then
	BEFORE_SUM=$(md5sum "$REPO_UPDATE" 2>/dev/null | awk '{print $1}')
	git -C "$INSTALLER_PATH" pull --ff-only || warn "git pull of installer failed — continuing with local files"
	AFTER_SUM=$(md5sum "$REPO_UPDATE" 2>/dev/null | awk '{print $1}')
	if [ -n "$BEFORE_SUM" ] && [ -n "$AFTER_SUM" ] && [ "$BEFORE_SUM" != "$AFTER_SUM" ]; then
		echo "Installer update script was updated — re-running..."
		exec bash "$REPO_UPDATE" "$@"
	fi
else
	warn "Installer path is not a git checkout: ${INSTALLER_PATH}"
fi

# Re-source after possible pull so the rest of this run uses the new library.
if [ -f "${INSTALLER_PATH}/lib/common.sh" ]; then
	HBLINK4_COMMON_LOADED=
	. "${INSTALLER_PATH}/lib/common.sh"
fi

clear
print_banner

if [ -f "${INSTALLER_PATH}/usr/local/sbin/update" ]; then
	find "${INSTALLER_PATH}/usr/local/sbin" -type f -exec sed -i 's/\r$//' {} \; 2>/dev/null || true
	sed -i 's/\r$//' "${INSTALLER_PATH}/lib/common.sh" 2>/dev/null || true
	install_control_scripts "$INSTALLER_PATH"
fi

clone_or_pull_hblink4 || exit 1
install_compose_tree "$INSTALLER_PATH"

note "Stopping stack..."
( cd "$HBDIR" && docker compose down --remove-orphans ) 2>/dev/null || true

note "Rebuilding local images (no Hub app image)..."
build_images_with_fallback || exit 1
prune_docker_leftovers

set_permissions
( cd "$HBDIR" && docker compose up -d )
sleep 3
docker ps --filter name=hblink4
echo
( cd "$HBDIR" && docker compose logs --tail=20 )
ok "HBlink4 Docker update is complete. Aka ShaYmez."
echo
echo "  For a clean --no-cache rebuild run:  hblink4-upgrade"
print_footer
