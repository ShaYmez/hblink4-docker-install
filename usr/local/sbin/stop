if [ -f /usr/local/lib/hblink4/common.sh ]; then
	. /usr/local/lib/hblink4/common.sh
else
	_ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
	if [ ! -f "${_ROOT}/lib/common.sh" ]; then
		_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
	fi
	. "${_ROOT}/lib/common.sh"
fi

require_root
clear
print_banner
note "Stopping HBlink4 engine + dashboard..."
dots
cd "$HBDIR" || exit 1
docker compose down --remove-orphans
ok "HBlink4 stack is now stopped. Aka ShaYmez."
